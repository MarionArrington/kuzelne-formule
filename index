<script>
document.addEventListener("DOMContentLoaded", function() {
    // 1. Obalenie GIFov
    const gifImages = document.querySelectorAll('img[src*="k-zlo.gif"]');
    gifImages.forEach(img => {
        const container = document.createElement('div');
        container.className = 'spell-card-container';
        if (img.align === "left") {
            container.style.float = "left";
            container.style.marginRight = "20px";
        }
        const card = document.createElement('div');
        card.className = 'spell-card';
        card.style.width = img.getAttribute('width') + 'px';
        card.style.height = img.getAttribute('height') + 'px';
        const newImg = img.cloneNode(true);
        newImg.removeAttribute('align');
        newImg.style.display = 'block';
        newImg.style.width = '100%';
        newImg.style.borderRadius = '10px';
        card.appendChild(newImg);
        container.appendChild(card);
        img.parentNode.replaceChild(container, img);
    });

    // 2. Aktivácia Lumos/Nox
    const allBigTags = document.querySelectorAll('big');
    allBigTags.forEach(tag => {
        const text = tag.innerText.toUpperCase();
        if(text.includes("LUMOS") || text.includes("NOX")) {
            tag.classList.add('clickable-spell');
            tag.onclick = function() {
                if(text.includes("LUMOS")) {
                    document.body.classList.remove('nox-mode');
                    document.body.classList.add('lumos-mode');
                } else {
                    document.body.classList.remove('lumos-mode');
                    document.body.classList.add('nox-mode');
                }
            };
        }
    });
});
</script>
